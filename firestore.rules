rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.createdAt is int
        && (!('updatedAt' in data) || data.updatedAt is int);
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'tone', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && (!('tone' in data) || (data.tone in ['balanced', 'direct', 'sheng', 'swahili']))
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp'])
        && data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'content', 'timestamp', 'language', 'tokensUsed'])
        && isValidId(data.id)
        && isValidId(data.conversationId)
        && data.userId == request.auth.uid
        && (data.role in ['user', 'assistant', 'system'])
        && data.content is string && data.content.size() <= 15000
        && data.timestamp is int
        && (!('language' in data) || (data.language in ['en', 'sw', 'sheng']))
        && (!('tokensUsed' in data) || data.tokensUsed is int);
    }

    function isValidTraining(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'prompt', 'response', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'title', 'prompt', 'response', 'enabled', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && (data.type in ['fact', 'qa', 'vocabulary', 'rule'])
        && data.title is string && data.title.size() <= 200
        && data.prompt is string && data.prompt.size() <= 2000
        && data.response is string && data.response.size() <= 5000
        && data.enabled is bool
        && data.createdAt is int
        && data.updatedAt is int;
    }

    // Users Collection (Strict PII isolation: users can only read and write their own profile)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow querying user list to prevent PII harvesting
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's custom training and memory entries
      match /trainings/{trainingId} {
        allow get: if isOwner(userId) && isValidId(trainingId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(trainingId)
          && request.resource.data.userId == request.auth.uid
          && isValidTraining(request.resource.data);
        allow update: if isOwner(userId) && isValidId(trainingId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidTraining(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(trainingId);
      }
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(conversationId)
        && request.resource.data.userId == request.auth.uid
        && isValidConversation(request.resource.data);
      allow update: if isSignedIn() && isValidId(conversationId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidConversation(request.resource.data);
      allow delete: if isSignedIn() && isValidId(conversationId) && resource.data.userId == request.auth.uid;

      // Messages Subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) && resource.data.userId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(messageId)
          && request.resource.data.userId == request.auth.uid
          && isValidMessage(request.resource.data);
        allow update: if isSignedIn() && isValidId(messageId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.uid
          && request.resource.data.timestamp == resource.data.timestamp
          && isValidMessage(request.resource.data);
        allow delete: if isSignedIn() && isValidId(messageId) && resource.data.userId == request.auth.uid;
      }
    }
  }
}
